includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    paths:
        - src
        - config
        - database

    # Filament is a suggestion, not a dependency, so its classes cannot be
    # resolved here. The resource is covered by the host application's suite.
    excludePaths:
        - src/Filament

    ignoreErrors:
        # This is the package's own config file; larastan only recognises the
        # application's config directory.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            paths:
                - config/*.php
